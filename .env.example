# NEXORA environment template
# Copy to `.env` for local development. Never commit the real `.env` file.
# See docs/configuration.md for the full configuration contract.

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
ENVIRONMENT=development

# Required. Use a long random value in every real environment.
JWT_SECRET_KEY=replace-with-a-secure-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30

# Login brute-force protection.
LOGIN_MAX_FAILED_ATTEMPTS=5
LOGIN_LOCKOUT_SECONDS=300

# Comma-separated browser origins. Empty disables CORS.
# Example: CORS_ORIGINS=https://app.example.com
CORS_ORIGINS=
CORS_ALLOW_CREDENTIALS=true

# -----------------------------------------------------------------------------
# PostgreSQL
# -----------------------------------------------------------------------------
DATABASE_URL=postgresql+psycopg://nexora:nexora@localhost:5432/nexora
# Used only by migration tests. The database name must contain `test`.
TEST_DATABASE_URL=postgresql+psycopg://nexora:nexora@localhost:5432/nexora_test

# -----------------------------------------------------------------------------
# File storage
# -----------------------------------------------------------------------------
STORAGE_BACKEND=local
STORAGE_PATH=storage
MAX_UPLOAD_SIZE_BYTES=10485760

# -----------------------------------------------------------------------------
# Embeddings and vector store
# -----------------------------------------------------------------------------
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIMENSION=1024
EMBEDDING_BATCH_SIZE=32
QDRANT_UPSERT_BATCH_SIZE=32

QDRANT_URL=http://localhost:6333
# Optional for hosted Qdrant. Leave empty for local development.
QDRANT_API_KEY=
QDRANT_COLLECTION=nexora_document_chunks

# -----------------------------------------------------------------------------
# Retrieval
# -----------------------------------------------------------------------------
# Number of chunks passed to the LLM after reranking.
RETRIEVAL_TOP_K=2
# Candidate counts for dense and BM25 retrieval.
RETRIEVAL_DENSE_TOP_K=10
RETRIEVAL_LEXICAL_TOP_K=10
# Number of fused candidates sent to the cross-encoder.
RETRIEVAL_RERANK_TOP_K=8
# Candidates below this reranker score are discarded.
RETRIEVAL_MIN_RELEVANCE=0.5

# -----------------------------------------------------------------------------
# LLM provider
# -----------------------------------------------------------------------------
# Supported values: `ollama`, `openai`.
LLM_PROVIDER=ollama

# Ollama (default; local inference)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:8b
OLLAMA_TIMEOUT=300
OLLAMA_NUM_PREDICT=256
OLLAMA_THINK=false

# OpenAI-compatible provider (optional)
# Required when LLM_PROVIDER=openai: OPENAI_API_KEY and OPENAI_MODEL.
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_BASE_URL=
OPENAI_TIMEOUT=120
OPENAI_MAX_TOKENS=512

# -----------------------------------------------------------------------------
# Production Docker Compose variables
# -----------------------------------------------------------------------------
# Used by docker-compose.prod.yml. For real deployment, provide these through
# a secure environment file or secret manager. Never commit real credentials.
POSTGRES_USER=nexora
POSTGRES_PASSWORD=replace-with-a-strong-password
POSTGRES_DB=nexora
API_PORT=8000

# Production notes:
# - Set ENVIRONMENT=production.
# - Use a fresh JWT_SECRET_KEY of at least 32 random characters.
# - Set explicit CORS_ORIGINS; `*` is rejected in production.
# - Configure the active LLM provider completely.
# - Use `docker compose --env-file /secure/path/prod.env ...` rather than
#   relying on an accidental `.env` file from the project directory.
# - See docs/deployment.md and docs/configuration.md before deployment.
