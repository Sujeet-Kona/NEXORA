DATABASE_URL=postgresql+psycopg://username:password@localhost:5432/nexora
TEST_DATABASE_URL=postgresql+psycopg://username:password@localhost:5432/nexora_test
# ENVIRONMENT is one of: development, testing, staging, production.
# In production, startup fails unless JWT_SECRET_KEY is strong/unique
# (>= 32 chars, not a known placeholder) and CORS_ORIGINS has no wildcard.
ENVIRONMENT=development
JWT_SECRET_KEY=replace-with-a-secure-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30
# Login brute-force protection: after LOGIN_MAX_FAILED_ATTEMPTS consecutive
# failures an email is locked out for LOGIN_LOCKOUT_SECONDS (HTTP 429).
LOGIN_MAX_FAILED_ATTEMPTS=5
LOGIN_LOCKOUT_SECONDS=300
# Comma-separated list of allowed browser origins, e.g.
# CORS_ORIGINS=https://app.example.com. Empty disables CORS entirely.
# A wildcard ("*") is rejected in production.
CORS_ORIGINS=
CORS_ALLOW_CREDENTIALS=true
STORAGE_BACKEND=local
STORAGE_PATH=storage
MAX_UPLOAD_SIZE_BYTES=10485760
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=nexora_document_chunks
RETRIEVAL_TOP_K=2
RETRIEVAL_DENSE_TOP_K=10
RETRIEVAL_LEXICAL_TOP_K=10
RETRIEVAL_RERANK_TOP_K=8
RETRIEVAL_MIN_RELEVANCE=0.5
# LLM_PROVIDER selects the generation backend: "ollama" or "openai"
# (any OpenAI-compatible /chat/completions endpoint).
# In production, startup fails unless the active provider is configured:
#   LLM_PROVIDER=ollama  -> OLLAMA_MODEL must be set
#   LLM_PROVIDER=openai  -> OPENAI_API_KEY and OPENAI_MODEL must be set
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:8b
OLLAMA_TIMEOUT=300
OLLAMA_NUM_PREDICT=256
OLLAMA_THINK=false
# Required only when LLM_PROVIDER=openai. OPENAI_BASE_URL is optional and
# lets you target a self-hosted OpenAI-compatible gateway.
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_BASE_URL=
OPENAI_TIMEOUT=120
OPENAI_MAX_TOKENS=512

# --- Production Docker Compose (docker-compose.prod.yml) ---
# The prod compose file builds DATABASE_URL from these Postgres values and
# requires POSTGRES_PASSWORD and JWT_SECRET_KEY to be set (no defaults).
# Supply them via the shell environment or `docker compose --env-file <file>`.
# Values below are placeholders — replace them and never commit real secrets.
POSTGRES_USER=nexora
POSTGRES_PASSWORD=replace-with-a-strong-password
POSTGRES_DB=nexora
# Host port published for the API container (the container always listens on 8000).
API_PORT=8000
